#!/bin/bash
#PBS -l nodes=1:ppn=2,walltime=4:00:00,vmem=20gb
#PBS -N app-map-atlas

set -e
set -x

imm_castType() {
    if [ $# -lt 2 ]; then
        echo "usage: imm_castType <input.ext> <output_type> [<output.ext>]"
        return 1
    fi

    local input="$1"
    local type="$2"
    local output="$3"

    [ -z "$output" ] && output="$input"

    singularity exec docker://brainlife/dipy:1.4.1 python3 - <<EOF_PY
import nibabel as nib
import numpy as np
import sys

input_file = "${input}"
output_file = "${output}"
dtype = "${type}"

type_map = {
    "char": np.int8,
    "short": np.int16,
    "int": np.int32,
    "float": np.float32,
    "double": np.float64,
    "uchar": np.uint8,
    "ushort": np.uint16,
    "uint": np.uint32,
}

img = nib.load(input_file)
data = np.asanyarray(img.dataobj)

data = np.nan_to_num(data, nan=0)
data[data < 0] = 0

if dtype == "intround":
    data = np.round(data).astype(np.int32)
    out_dtype = np.int32

elif dtype in type_map:
    if np.issubdtype(type_map[dtype], np.integer):
        data = np.round(data)

    data = data.astype(type_map[dtype])
    out_dtype = type_map[dtype]

else:
    sys.stderr.write(f"Unsupported type: {dtype}\\n")
    sys.exit(1)

new_img = nib.Nifti1Image(data, img.affine, img.header)
new_img.set_data_dtype(out_dtype)

new_img.header["scl_slope"] = 1
new_img.header["scl_inter"] = 0

nib.save(new_img, output_file)

print("saved:", output_file)
print("dtype:", out_dtype)
print("unique:", np.unique(data)[:20])
EOF_PY
}

copy_label_json() {
    local atlas_name="$1"
    local outdir="$2"
    local label_json="${LABEL_DIR}/${atlas_name}/label.json"

    if [[ -f "${label_json}" ]]; then
        cp "${label_json}" "${outdir}/label.json"
    else
        echo "WARNING: missing label file: ${label_json}"
    fi
}

atlas_label_name() {
    local map_name="$1"

    if [[ "${map_name}" == wang15* ]]; then
        echo "wang15"
    elif [[ "${map_name}" == benson14* ]]; then
        echo "benson14"
    elif [[ "${map_name}" == glasser16* ]]; then
        echo "glasser16"
    elif [[ "${map_name}" == rosenke18* ]]; then
        echo "rosenke18"
    else
        echo "${map_name}"
    fi
}

APPDIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LABEL_DIR="${APPDIR}/src/atlases"

fsdir=$(jq -r '.freesurfer' config.json)
atlas=$(jq -r '.atlas' config.json)
reference=$(jq -r '.reference' config.json)

docker=docker://brainlife/neuropythy:0.12.16

opt=()
if [[ -n "${reference}" && "${reference}" != "null" ]]; then
  opt+=(--image-template "${reference}")
fi

freesurfer=./freesurfer
if [[ ! -d "${freesurfer}" ]]; then
  cp -LR "${fsdir}" "${freesurfer}"
  chmod -R +w "${freesurfer}"
fi

parcellation=./parcellation
surfaces=./surfaces
volumes=./volumes

mkdir -p "${parcellation}" "${surfaces}" "${volumes}"

echo "Running neuropythy atlas"
echo "python -m neuropythy atlas \
  --verbose \
  --atlases ${atlas} \
  --volume-export \
  --volume-path ./volumes \
  --output-path ./surfaces \
  ${opt[*]} \
  ./freesurfer"

singularity exec -e "${docker}" \
  python -m neuropythy atlas \
  --verbose \
  --atlases "${atlas}" \
  --volume-export \
  --volume-path ./volumes \
  --output-path ./surfaces \
  "${opt[@]}" \
  ./freesurfer

if [[ -z "${FREESURFER_LICENSE}" ]]; then
  echo "Please set FREESURFER_LICENSE in .bashrc"
  exit 1
fi

echo "${FREESURFER_LICENSE}" > license.txt

if [[ "${atlas}" == "glasser16" || "${atlas}" == "rosenke18" ]]; then

    file_mgz=$(find "${volumes}" -maxdepth 1 -name '*.mgz' | head -n 1)

    if [[ -z "${file_mgz}" ]]; then
        echo "ERROR: no .mgz file found in ${volumes}"
        exit 1
    fi

    singularity exec -e \
        -B "$(pwd)/license.txt:/usr/local/freesurfer/license.txt" \
        docker://brainlife/freesurfer:7.3.2 \
        mri_convert "${file_mgz}" "${file_mgz//.mgz/.nii.gz}"

    cp "${file_mgz//.mgz/.nii.gz}" "${parcellation}/parc.nii.gz"
    imm_castType "${parcellation}/parc.nii.gz" ushort
    copy_label_json "${atlas}" "${parcellation}"

else

    for file_mgz in "${volumes}"/*.mgz; do
      [[ -e "${file_mgz}" ]] || continue

      file_bname=$(basename "${file_mgz}")
      map_name="${file_bname%.mgz}"

      singularity exec -e \
        -B "$(pwd)/license.txt:/usr/local/freesurfer/license.txt" \
        docker://brainlife/freesurfer:7.3.2 \
        mri_convert "${file_mgz}" "${file_mgz//.mgz/.nii.gz}"

      echo "${map_name}"

      if [[ "${map_name}" != "wang15_fplbl" && \
            "${map_name}" != "benson14_eccen" && \
            "${map_name}" != "benson14_angle" && \
            "${map_name}" != "benson14_sigma" ]]; then

          cp "${file_mgz//.mgz/.nii.gz}" "${parcellation}/parc.nii.gz"
          imm_castType "${parcellation}/parc.nii.gz" ushort

          label_atlas=$(atlas_label_name "${map_name}")
          copy_label_json "${label_atlas}" "${parcellation}"
      fi

    done

fi
